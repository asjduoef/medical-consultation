# Supabase Configuration
# These values are available from your Supabase project dashboard
# under Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side only (NEVER expose to the browser)
# Used for edge functions and server-side operations
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Future integrations (not yet in use):
# RAZORPAY_KEY_ID=your-razorpay-key-id
# RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# DAILY_API_KEY=your-daily-api-key
# SES_ACCESS_KEY=your-ses-access-key
# SES_SECRET_KEY=your-ses-secret-key
